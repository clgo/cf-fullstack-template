# ── Worker identity ──────────────────────────────────────────────────────────
# ⚠️  Change 'myapp-api' to your Worker name
name = "myapp-api"
main = "src/index.ts"
compatibility_date = "2025-01-01"
compatibility_flags = ["nodejs_compat"]

# Workers Unbound: removes the 30 s wall-clock limit (standard plan).
# Required for long-running tasks (AI inference, large file processing).
# Requires Cloudflare Workers Paid plan. Remove if you are on the free plan.
usage_model = "unbound"

# ── Hostname & access ────────────────────────────────────────────────────────
# The app lives on one hostname: Pages serves the frontend (add the domain under
# Pages → Custom domains) and this route sends /api/* to the Worker. A Cloudflare
# Access application on the same hostname protects both.
routes = [
  { pattern = "REPLACE_WITH_APP_DOMAIN/api/*", zone_name = "REPLACE_WITH_ZONE" },
]
# No workers.dev or preview URLs: they would reach the API without the Access login
workers_dev = false
preview_urls = false

# ── D1 Database ───────────────────────────────────────────────────────────────
[[d1_databases]]
binding = "DB"
# ⚠️  Change 'myapp-db' to your database name (from `wrangler d1 create`)
database_name = "myapp-db"
# Replaced by CI from D1_DATABASE_ID secret; fill in manually for local dev
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# ── R2 Bucket ─────────────────────────────────────────────────────────────────
[[r2_buckets]]
binding = "BUCKET"
# ⚠️  Change 'myapp-docs' to your bucket name (from `wrangler r2 bucket create`)
bucket_name = "myapp-docs"

# ── Workers AI ────────────────────────────────────────────────────────────────
[ai]
binding = "AI"

# ── Cron Triggers ─────────────────────────────────────────────────────────────
# Remove or modify these crons for your app.
# Format: "minute hour day month weekday" (UTC)
[triggers]
crons = [
  # Example: daily job at 00:00 SGT (16:00 UTC)
  "0 16 * * *",
  # Example: monthly job on the 1st at 01:00 UTC
  "0 1 1 * *"
]

# ── Non-secret vars ───────────────────────────────────────────────────────────
# Secrets go in .dev.vars (local) or `wrangler secret put` (production)
[vars]
ENVIRONMENT = "production"
# Cloudflare Access — the API refuses every request (503) until both are set.
# Team domain: Zero Trust → Settings → Custom Pages (e.g. myteam.cloudflareaccess.com)
ACCESS_TEAM_DOMAIN = "REPLACE_WITH_ACCESS_TEAM_DOMAIN"
# Zero Trust → Access → Applications → <your app> → Overview → Application Audience (AUD) Tag
ACCESS_AUD = "REPLACE_WITH_ACCESS_AUD"
# Set to "false" to pause cron jobs without redeploying
CRON_ENABLED = "true"

# ── Secrets reference (set via `wrangler secret put <NAME>`) ─────────────────
# OPENAI_API_KEY     — (optional) OpenAI key for paid AI features
